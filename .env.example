# App Environment Configuration (Copy to .env on Hostinger / Server)
APP_ENV=production
APP_URL=https://flowbypak.com
JWT_SECRET=pakflow_super_secret_production_key_2026

# MySQL Database Settings (From Hostinger hPanel -> Databases -> Management)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_db_name
DB_USER=your_hostinger_db_user
DB_PASS=your_hostinger_db_password
DB_CHARSET=utf8mb4
DB_PERSISTENT=true

# Optional SMTP Overrides (defaults configured in src/Mailer.php)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=support@flowbypak.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM_NAME=PakFlow Support

# Optional: Secret key for one-click web migration (/api/admin/migrate-mysql?key=...)
# Leave EMPTY after migration is finished!
MIGRATE_KEY=
